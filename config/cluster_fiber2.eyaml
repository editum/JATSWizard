---
# Añado los cambios necesarios para tener una mysql local para ver si así se agiliza el servidor

# Database config
profile::revistas::db_host: 'localhost'
profile::revistas::db_port: '3306'
profile::revistas::enable_cdn: 'Off'
profile::revistas::magic_mime: '/etc/mime.types'

role::revistas_um_es::mysql::datadir: '/var/lib/mysql'
role::revistas_um_es::mysql::binlogs: '/home/mysql-binlogs'
role::revistas_um_es::mysql::query_cache_limit: '4M'
role::revistas_um_es::mysql::query_cache_size: '16M'

role::revistas_um_es::bitbucket::docxConverter::token: ENC[GPG,]
role::revistas_um_es::bitbucket::lensgalley::token: ENC[GPG,]
role::revistas_um_es::bitbucket::preview::token: ENC[GPG,]

# Mail config
profile::revistas::smtp_server: 'smtp.um.es'

profile::base::files:
  /usr/share/misc/magic:
    ensure: 'link'
    force: true
    target: "%{hiera('profile::revistas::magic_mime')}"
  /usr/share/misc/magic.mime:
    ensure: 'link'
    force: true
    target: "%{hiera('profile::revistas::magic_mime')}"

profile::zfs::fs:
  datapool/mysql:
    ensure: present
    compression: lz4
    atime: off
    devices: off
    setuid: off
    recordsize: 16K
    mountpoint: "%{hiera('role::revistas_um_es::mysql::datadir')}"
  datapool/mysql_binlogs:
    ensure: present
    compression: lz4
    atime: off
    devices: off
    setuid: off
    recordsize: 16K
    mountpoint: "%{hiera('role::revistas_um_es::mysql::binlogs')}"
    require: Zfs[datapool/mysql]
    nagios_command: 'check_disk_by_root'
  datapool/backups:
    ensure: present
    compression: lz4
    atime: off
    devices: off
    setuid: off
    recordsize: 16K
    mountpoint: /home/backups
profile::zfs::exclude_snap:
  - 'datapool/backups'
  - 'datapool/mysql_binlogs'

#
# Paquetes necesarios
profile::base::packages:
  php7.2-mbstring:
    ensure: 'absent'
  php7.4-mbstring:
    ensure: 'installed'
  php-memcached:
    ensure: 'installed'
  php-gd:
    ensure: 'installed'
  php-intl:
    ensure: 'installed'
  php-json:
    ensure: 'installed'
  php-xml:
    ensure: 'installed'
  php-zip:
    ensure: 'installed'
  libphp-adodb:
    ensure: 'installed'
  percona-toolkit:
    ensure: 'installed'

#
# Configuración para el servidor MySQL
#
profile::mysql::restart: true
profile::mysql::long_query_time: 5
profile::mysql::override_options:
  mysqld:
    # Optimización
    key_buffer_size: 1842M
    max_user_connections: 128
    read_rnd_buffer_size: 16M
    sort_buffer_size: 32M
    # Para permitir adjunto mayores
    max_allowed_packet: 25M
    # Configuración de InnoDB
    innodb_log_buffer_size: 16M
    innodb_buffer_pool_size: 3G
    innodb_thread_concurrency: 8
    # Igualo al número de Gb del pool size
    innodb_buffer_pool_instances: 3
    # Si usas SSD
    #innodb_flush_neighbors: 0
    #innodb_page_size: 64k  -- no añadir da error
    # Configuro autoborrado de logs binarios diario
    expire_logs_days: 1
    # Configuro metodo autenticación para poder acceder desde phpmyadmin de neomys
    # default_authentication_plugin: 'mysql_native_password'
    # Nº Max de errors de conexion permitidos para un host (lo subimos por el valor por defecto es muy bajo 10)
    max_connect_errors: 1000
    read_buffer_size: 4M
    table_open_cache: 64k
    table_open_cache_instances: 16
    tmp_table_size: 512M
    max_heap_table_size: 512M
    # Nivel de logs TLMS-23335  a sólo Error 
    log_error_verbosity: 1

  mysqld-5.7:
    query_cache_limit: "%{hiera('role::revistas_um_es::mysql::query_cache_limit')}"
    query_cache_size: "%{hiera('role::revistas_um_es::mysql::query_cache_size')}"

